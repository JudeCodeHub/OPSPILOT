# Copy to .env to override compose.yaml defaults:  cp .env.example .env
# After changing a value, recreate only the affected service, e.g.
#   docker compose up -d payment
# Every value below is the safe default (everything healthy).

# ---- general ----------------------------------------------------------------
LOG_LEVEL=info
POSTGRES_PASSWORD=opspilot

# ---- gateway ----------------------------------------------------------------
GATEWAY_UPSTREAM_TIMEOUT=3s
GATEWAY_FAIL_RATE=0
GATEWAY_SLOW_MS=0
GATEWAY_LEAK_MEMORY=false
GATEWAY_LEAK_MB_PER_MIN=20
GATEWAY_CPU_BURN=false

# ---- events -----------------------------------------------------------------
# Slow DB scenario: 2000
EVENTS_SLOW_QUERY_MS=0
EVENTS_FAIL_RATE=0
EVENTS_SLOW_MS=0
EVENTS_LEAK_MEMORY=false
EVENTS_LEAK_MB_PER_MIN=20
EVENTS_CPU_BURN=false

# ---- booking ----------------------------------------------------------------
# Crashloop scenario: postgres-wrong
BOOKING_DB_HOST=postgres
BOOKING_PAYMENT_TIMEOUT=2s
BOOKING_HOLD_TTL_SECONDS=300
# DB pool exhaustion scenario: 1 (plus load)
BOOKING_DB_POOL_MAX=10
BOOKING_FAIL_RATE=0
BOOKING_SLOW_MS=0
BOOKING_LEAK_MEMORY=false
BOOKING_LEAK_MB_PER_MIN=20
BOOKING_CPU_BURN=false

# ---- payment ----------------------------------------------------------------
# Payment errors scenario: 0.5
PAYMENT_FAIL_RATE=0
# Payment slow / cascade scenario: 3000
PAYMENT_SLOW_MS=0
PAYMENT_LEAK_MEMORY=false
PAYMENT_LEAK_MB_PER_MIN=20
PAYMENT_CPU_BURN=false

# ---- ticketing --------------------------------------------------------------
# Slow processing / backlog scenario: 5000
TICKETING_PROCESS_DELAY_MS=0
TICKETING_FAIL_RATE=0
TICKETING_SLOW_MS=0
# Memory leak scenario: true
TICKETING_LEAK_MEMORY=false
TICKETING_LEAK_MB_PER_MIN=20
TICKETING_CPU_BURN=false

# ---- notify -----------------------------------------------------------------
# Stuck consumer scenario: true
NOTIFY_PAUSE_CONSUMER=false
NOTIFY_FAIL_RATE=0
NOTIFY_SLOW_MS=0
NOTIFY_LEAK_MEMORY=false
NOTIFY_LEAK_MB_PER_MIN=20
NOTIFY_CPU_BURN=false
